# Copy to .env for local use (never commit .env). All values below are fake examples.
APP_ENV=development
DATABASE_PATH=./classbook.db
ADMIN_EMAIL=maya@example.com
ADMIN_PASSWORD=change-me-to-14-or-more-characters
# ADMIN_PASSWORD is the admin's real password: changing it here and restarting RESETS the stored password (the recovery step, AR-1).
# ADMIN_PROMOTE_EXISTING=true: only needed if ADMIN_EMAIL already belongs to a student account and no admin exists yet.
#   Without it the app refuses to start (it will not silently turn a student into the admin). That account gets the admin role and the ADMIN_PASSWORD.
# ADMIN_ALLOW_EMAIL_CHANGE=true: only needed to change ADMIN_EMAIL once an admin exists. Without it the app refuses to start.
#   Turn both flags off again after one successful start.
# ADMIN_PROMOTE_EXISTING=false
# ADMIN_ALLOW_EMAIL_CHANGE=false
# 0 locally; 1 behind Render's proxy (required when APP_ENV=production)
TRUSTED_PROXY_HOPS=0
MAIL_BACKEND=recording
# Local run:  set -a; . ./.env; set +a; uvicorn --factory classbook.app:create_app --workers 1
